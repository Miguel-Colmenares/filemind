# Variables de entorno de FileMind. Copia este archivo como «.env» y ajusta lo que necesites.
# Todas son opcionales: sin .env FileMind usa backend/config.json y valores seguros por defecto.
# Una variable FILEMIND_* reemplaza la clave del mismo nombre en backend/config.json.
# Deja comentadas (#) las que no uses: una variable vacía no es lo mismo que no definirla.

# ------------------------------------------------------------------ API y acceso
# Puerto local de la API en Docker (el proxy HTTPS apunta aquí)
# FILEMIND_PORT=8000
# IPs del proxy en las que se confía para X-Forwarded-Proto/For (cookie «Secure» con HTTPS).
# «*» sirve dentro de Docker porque la API solo escucha en 127.0.0.1 del servidor.
# FORWARDED_ALLOW_IPS=*
# Horas que dura una sesión iniciada en la web
# FILEMIND_SESSION_HOURS=12
# Token de servicio del puente de WhatsApp. Vacío = se genera solo en backend/data/api_token.txt.
# Si lo defines, usa el mismo valor en FILEMIND_TOKEN del puente.
# FILEMIND_API_TOKEN=

# Carpeta del PC donde quedan los archivos del bufete (Docker la monta como /bufete).
# Vacío = carpeta «bufete» del proyecto. En Windows usa barras /, p. ej. C:/Users/Yo/Documents/FileMind_Bufete
# FILEMIND_BUFETE_HOST=
# Disco o carpeta del PC que se puede recorrer en el selector de carpetas (Docker lo monta como /pc).
# Ejemplo en Windows: C:/  (da acceso de lectura y escritura a todo el disco desde el contenedor)
# FILEMIND_PC_HOST=

# ------------------------------------------------------------------ Análisis
# Perfil de categorías: constitucional (sentencias reales) | juridico | general
# FILEMIND_PERFIL=constitucional
# Chats monitoreados al primer arranque (JSON). Después se escogen en la página Chats de WhatsApp.
# FILEMIND_MONITORED_GROUPS=["Expedientes del bufete"]
# Puntaje de riesgo a partir del cual el archivo va a cuarentena (RF8)
# FILEMIND_QUARANTINE_THRESHOLD=70
# Tamaño máximo por archivo (MB) y tiempo máximo del protocolo (s)
# FILEMIND_MAX_FILE_MB=20
# FILEMIND_MAX_PROTOCOL_SECONDS=15
# Confianza mínima del clasificador; por debajo el archivo va a «Otros» para revisión humana
# FILEMIND_TOPIC_MIN_CONFIDENCE=0.35
# Hilos de análisis en paralelo
# FILEMIND_WORKERS=4
# Retención de la auditoría en días (mínimo 183 = 6 meses, RNF8)
# FILEMIND_LOG_RETENTION_DAYS=183

# ------------------------------------------------------------------ Fase 3 (entorno aislado)
# auto | docker | namespace | subprocess. En docker-compose el valor por defecto es «docker»
# (contenedores hermanos sin red). Lee DEPLOY.md: «subprocess» aísla menos pero no expone Docker.
# FILEMIND_SANDBOX_BACKEND=docker
# FILEMIND_SANDBOX_TIMEOUT_S=8
# FILEMIND_SANDBOX_IMAGE=python:3.11-slim

# ------------------------------------------------------------------ Servicios externos (opcionales)
# Claves de las bases de firmas de malware. Sin clave solo se usa la lista local.
# FILEMIND_MALWAREBAZAAR_API_KEY=
# FILEMIND_VIRUSTOTAL_API_KEY=
# FILEMIND_EXTERNAL_LOOKUP_TIMEOUT_S=3
# Consultar la antigüedad de los dominios de los enlaces por RDAP (requiere internet)
# FILEMIND_RDAP_LOOKUP=false
# Webhook que recibe cada notificación (JSON) además de la interfaz
# FILEMIND_NOTIFY_WEBHOOK=

# ------------------------------------------------------------------ Puente de WhatsApp
# Encender el puente junto con «python -m filemind serve» (fuera de Docker). En Docker se apaga solo.
# FILEMIND_WHATSAPP_AUTOSTART=true
# Número que recibe las alertas por chat privado, formato 57XXXXXXXXXX@c.us. Vacío = no enviar.
# NOTIFY_TO=
# true = también avisar en el grupo cuando un archivo quede en cuarentena
# NOTIFY_IN_GROUP=true
# Mensajes del historial que se revisan al «Traer archivos anteriores» de un chat
# EXPORT_LIMIT=1000
