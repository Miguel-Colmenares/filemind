# URL de la API de FileMind
FILEMIND_URL=http://127.0.0.1:8000
# Token de servicio. Vacío = se lee solo de backend/data/api_token.txt (lo crea FileMind al arrancar).
# Si en config.json defines api_token, pon aquí el mismo valor.
FILEMIND_TOKEN=
# Número que recibe las alertas por chat privado (formato 57XXXXXXXXXX@c.us). Vacío = no enviar.
NOTIFY_TO=
# true = también avisar en el grupo cuando un archivo quede en cuarentena
NOTIFY_IN_GROUP=true
